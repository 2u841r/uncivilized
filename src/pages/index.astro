---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1100px;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li * {
				text-decoration: none;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.2;
				font-size: 1rem;
			}
			.date {
				margin: 0.25rem 0 0 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}


			@media (max-width: 900px) {
				main {
					width: 100%;
				}
				ul {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 560px) {
				ul {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="sr-only">{SITE_TITLE}</h1>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/${post.id}/`}>
									{post.data.heroImage && (
										<Image
											width={480}
											height={270}
											src={post.data.heroImage}
											alt=""
											transition:name={`thumb-${post.id}`}
										/>
									)}
									<h4 class="title" transition:name={`title-${post.id}`}>
										{post.data.title}
									</h4>
									<p class="date" transition:name={`date-${post.id}`}>
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
		<script>
			// Clicking a post link is a fresh navigation (pushState), so
			// the browser/ClientRouter always start it at the top - unlike
			// the back button (popstate), which already restores scroll
			// natively/via bfcache. This replicates that "back" feel for the
			// logo link WITHOUT touching real back navigations: only act
			// when astro:before-preparation reports direction "forward" (an
			// actual link click), never "back" - otherwise this clobbers the
			// native restoration that already works for the browser's back
			// button.
			//
			// Everything lives on window and is wired exactly once, since this
			// script tag re-runs on every swap-in of this page (view
			// transitions), not just the first load.
			if (!window.__homeScrollWired) {
				window.__homeScrollWired = true;
				window.__homeLastScrollY = window.scrollY;

				// tracked continuously, not read lazily at before-preparation
				// time, since the transition can already be mid-scroll-reset by
				// the time that event fires
				window.addEventListener(
					'scroll',
					() => {
						window.__homeLastScrollY = window.scrollY;
					},
					{ passive: true },
				);

				document.addEventListener('astro:before-preparation', (event) => {
					window.__lastNavWasForward = event.direction === 'forward';
					if (location.pathname === '/' && event.direction === 'forward') {
						sessionStorage.setItem('home-scroll-y', String(window.__homeLastScrollY));
					}
				});

				document.addEventListener('astro:page-load', () => {
					if (location.pathname !== '/' || !window.__lastNavWasForward) return;
					const saved = sessionStorage.getItem('home-scroll-y');
					if (saved !== null) {
						window.scrollTo(0, parseInt(saved, 10));
						sessionStorage.removeItem('home-scroll-y');
					}
				});
			}
		</script>
	</body>
</html>
