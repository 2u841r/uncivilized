---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { id: string; showDate?: boolean };

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	videoId,
	id,
	colorLeft,
	colorCenter,
	colorRight,
	colorLeftBottom,
	colorCenterBottom,
	colorRightBottom,
	showDate = true,
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage?.src} />
		<style>
			/* the ambient glow layers extend ~100px past the viewport on each
			   side (to hide the blur-clip seam), which would otherwise create
			   a horizontal scrollbar on every post page */
			html,
			body {
				overflow-x: hidden;
				overflow-x: clip;
			}
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				/* global.css puts padding:3em 1em on main; without
				   border-box, that padding adds on top of width:100% and
				   pushes main past the viewport. */
				box-sizing: border-box;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.video-embed {
				position: relative;
				width: 100%;
				max-width: 1020px;
				aspect-ratio: 16 / 9;
				margin: 0 auto;
				border-radius: 12px;
				overflow: hidden;
				box-shadow: var(--box-shadow);
				background: #000;
			}
			.video-embed img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				cursor: pointer;
			}
			.video-embed iframe {
				width: 100%;
				height: 100%;
				border: 0;
				display: block;
			}
			.video-embed .play-button {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: 68px;
				height: 48px;
				background: rgba(0, 0, 0, 0.75);
				border-radius: 14px;
				display: flex;
				align-items: center;
				justify-content: center;
				pointer-events: none;
				transition: background 0.2s ease;
			}
			.video-embed:hover .play-button {
				background: rgb(200, 0, 0);
			}
			.video-embed .play-button svg {
				width: 24px;
				height: 24px;
				fill: #fff;
			}
			.prose {
				/* main already insets via its own padding (global.css); no
				   extra "- 2em"/left-right padding here, or the inset
				   stacks three deep and mobile ends up over-padded. */
				width: 720px;
				max-width: 100%;
				margin: auto;
				/* .title already has margin-bottom:1em after its <hr>; no
				   padding-top here or the gap before the first line stacks. */
				padding: 0 0 1em;
				color: rgb(var(--gray-dark));
				text-align: justify;
				text-wrap: pretty;
			}
			.prose :global(:is(h1, h2, h3, h4, h5, h6)) {
				text-align: left;
				font-size: 1.5em;
			}
			.glow-zone {
				position: relative;
			}
			.glow-zone .hero-image,
			.glow-zone .title {
				position: relative;
				z-index: 1;
			}
			.title {
				width: 720px;
				max-width: 100%;
				margin: 0 auto 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.ambient-glow,
			.ambient-glow-bottom {
				position: absolute;
				/* Kept flush with the viewport (not wider) - an
				   absolutely-positioned child's own box extent bubbles up
				   into body's scrollable width even under overflow-x:hidden
				   on html/body, which mobile browsers let touch-scroll drag
				   into. The seam-hiding bleed instead lives on the
				   .glow-blob children below, whose overflow is real child
				   overflow and is fully absorbed by this box's own
				   overflow:hidden without inflating body. */
				left: 0;
				width: 100%;
				height: 900px;
				max-height: 70vh;
				overflow: hidden;
				pointer-events: none;
				z-index: 0;
			}
			.ambient-glow {
				top: 0;
				/* Small plateau at the very top (matches the header, which
				   wants strong solid color) then a long gradual taper. A
				   plateau immediately followed by a fast fade reads as a
				   hard edge - keeping the taper long and gradual avoids that
				   while still leaving the layer visibly present most of the
				   way down, so it has real overlap with the bottom glow's
				   fade-in instead of both being faint at the same point. */
				mask-image: linear-gradient(to bottom, black 0%, black 20%, transparent 100%);
				-webkit-mask-image: linear-gradient(to bottom, black 0%, black 20%, transparent 100%);
			}
			.ambient-glow-bottom {
				bottom: 0;
				height: 700px;
				/* Ramps in, stays fully visible through the middle, then
				   tapers out - a single-point peak (old version) meant this
				   layer was only briefly at full strength, so where the top
				   glow had already faded and this one hadn't ramped up yet,
				   both were faint at once: a dark dip right between them. */
				mask-image: linear-gradient(
					to bottom,
					transparent 0%,
					black 20%,
					black 60%,
					transparent 100%
				);
				-webkit-mask-image: linear-gradient(
					to bottom,
					transparent 0%,
					black 20%,
					black 60%,
					transparent 100%
				);
			}
			.glow-blob {
				position: absolute;
				top: -30%;
				width: 90%;
				height: 160%;
				/* closest-side sizing makes the gradient reach full transparency
				   exactly at the box's flat left/right edges. The default
				   farthest-corner sizing barely fades along those edges on a
				   tall narrow box, so the color got clipped by the box
				   boundary instead of fading out - the hard rectangle edge. */
				background: radial-gradient(circle closest-side, var(--glow-color) 0%, transparent 100%);
				opacity: 0.7;
				/* extra blur on top of the gradient's own falloff so overlapping
				   blobs blend into each other instead of showing seams
				   (the hard split reported on mobile) */
				filter: blur(70px);
			}
			.glow-left {
				left: -18%;
				--glow-color: var(--color-left);
			}
			.glow-center {
				left: 50%;
				transform: translateX(-50%);
				width: 90%;
				--glow-color: var(--color-center, var(--color-left));
			}
			.glow-right {
				right: -18%;
				--glow-color: var(--color-right);
			}
			header,
			main {
				position: relative;
				z-index: 1;
			}
			@media (max-width: 700px) {
				/* on narrow screens the blobs sit closer together, so the same
				   opacity reads as a hard band instead of a smooth blend */
				.ambient-glow {
					height: 680px;
					/* longer solid plateau so the color reaches full strength
					   behind the navbar instead of already tapering there */
					mask-image: linear-gradient(to bottom, black 0%, black 30%, transparent 100%);
					-webkit-mask-image: linear-gradient(to bottom, black 0%, black 30%, transparent 100%);
				}
				.ambient-glow-bottom {
					height: 620px;
					/* this glow lives inside main, whose own 1em padding
					   insets it from the true edge (unlike the top glow,
					   which is a direct sibling of main/header under body
					   and has no such inset) - extend by exactly that
					   padding to reach the true edge without going past it */
					left: -1em;
					width: calc(100% + 2em);
					/* taller box (still bottom-anchored) reaches further up
					   into the title area on narrow screens */
					mask-image: linear-gradient(
						to bottom,
						transparent 0%,
						black 30%,
						black 65%,
						transparent 100%
					);
					-webkit-mask-image: linear-gradient(
						to bottom,
						transparent 0%,
						black 30%,
						black 65%,
						transparent 100%
					);
				}
				.glow-blob {
					opacity: 0.6;
					filter: blur(60px);
				}
				.glow-left,
				.glow-right {
					/* wider + more overhang so the color reaches the left/right
					   edges - safe on mobile because .ambient-glow itself stays
					   flush (width:100%) and absorbs this via its own
					   overflow:hidden, it doesn't widen body */
					width: 100%;
				}
				.glow-left {
					left: -30%;
				}
				.glow-right {
					right: -30%;
				}
				.glow-center {
					width: 80%;
				}
				.title h1 {
					font-size: 2em;
				}
			}
		</style>
	</head>

	<body>
		{colorLeft && colorRight && (
			<div
				class="ambient-glow"
				style={`--color-left:${colorLeft}; --color-center:${colorCenter ?? ''}; --color-right:${colorRight};`}
			>
				<div class="glow-blob glow-left" />
				{colorCenter && <div class="glow-blob glow-center" />}
				<div class="glow-blob glow-right" />
			</div>
		)}
		<Header />
		<main>
			<article>
				<div class="glow-zone">
					{colorLeftBottom && colorRightBottom && (
						<div
							class="ambient-glow-bottom"
							style={`--color-left:${colorLeftBottom}; --color-center:${colorCenterBottom ?? ''}; --color-right:${colorRightBottom};`}
						>
							<div class="glow-blob glow-left" />
							{colorCenterBottom && <div class="glow-blob glow-center" />}
							<div class="glow-blob glow-right" />
						</div>
					)}
					<div class="hero-image">
						{videoId ? (
							<div class="video-embed" data-video-id={videoId}>
								{heroImage && (
									<Image
										width={1020}
										height={574}
										src={heroImage}
										alt={`Play video: ${title}`}
										transition:name={`thumb-${id}`}
									/>
								)}
								<div class="play-button" aria-hidden="true">
									<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
								</div>
							</div>
						) : (
							heroImage && (
								<Image
									width={1020}
									height={574}
									src={heroImage}
									alt=""
									transition:name={`thumb-${id}`}
								/>
							)
						)}
					</div>
					<div class="title">
						{
							showDate && (
								<div class="date" transition:name={`date-${id}`}>
									<FormattedDate date={pubDate} />
									{updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)}
								</div>
							)
						}
						<h1 transition:name={`title-${id}`}>{title}</h1>
						<hr />
					</div>
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script>
			function initVideoEmbeds() {
				document.querySelectorAll<HTMLElement>('.video-embed[data-video-id]').forEach((el) => {
					if (el.dataset.wired) return;
					el.dataset.wired = 'true';
					el.addEventListener('click', () => {
						const videoId = el.dataset.videoId;
						if (!videoId) return;
						const iframe = document.createElement('iframe');
						iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
						iframe.title = 'YouTube video player';
						iframe.allow =
							'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
						iframe.allowFullscreen = true;
						// Astro's scoped styles don't reach elements created via JS,
						// so size it explicitly instead of relying on the .video-embed iframe rule.
						iframe.style.width = '100%';
						iframe.style.height = '100%';
						iframe.style.border = '0';
						iframe.style.display = 'block';
						el.replaceChildren(iframe);
					});
				});
			}
			initVideoEmbeds();
			document.addEventListener('astro:page-load', initVideoEmbeds);
		</script>
	</body>
</html>
